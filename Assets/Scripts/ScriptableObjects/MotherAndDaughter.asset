  m_Name: MotherAndDaughter
  m_EditorClassIdentifier: Assembly-CSharp::Chat
  Name: "\u041B\u0438\u0437\u0430"
  Talks:
  - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
      \u0418 \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0435
      \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C! "
    Options:
    - ...
    NextTalkIndices: 01000000
  - Text: "\u0412\u044B \u0436\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0448\u0435\u0440\u0438\u0444,
      \u043D\u0435 \u0442\u0430\u043A \u043B\u0438?"
    Options:
    - "\u0414\u0430"
    - "\u041D\u0435\u0442"
    - "\u041D\u0435 \u0437\u043D\u0430\u044E"
    NextTalkIndices: 020000000300000004000000
  - Text: "\u0421\u043B\u0430\u0432\u0430 \u0431\u043E\u0433\u0443, \u0447\u0442\u043E
      \u0432\u044B \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C!"
    Options:
    - "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    NextTalkIndices: 05000000
  - Text: "\u0412\u0441\u0435 \u0440\u0430\u0432\u043D\u043E, \u0441\u043F\u0430\u0441\u0438\u0431\u043E
      \u0432\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0435!"
    Options:
    - "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    NextTalkIndices: 05000000
  - Text: "\u041D\u0443... \u0423 \u0432\u0430\u0441 \u0437\u0432\u0435\u0437\u0434\u0432
      \u043D\u0430 \u0448\u043B\u044F\u043F\u0435... \u0418 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442...
      \u0412\u044B \u0448\u0435\u0440\u0438\u0444!"
    Options:
    - "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    NextTalkIndices: 05000000
  - Text: "\u041D\u0430 \u043D\u0430\u0441 \u043D\u0430\u043F\u0430\u043B\u0438 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438!"
    Options:
    - "\u0413\u0434\u0435 \u043E\u043D\u0438?"
    - "\u041F\u043E\u043A\u0430"
    NextTalkIndices: 06000000ffffffff
  - Text: "\u041E\u043D\u0438 \u0443\u0448\u043B\u0438 \u043F\u043E \u043C\u043E\u0441\u0442\u0443!
      \u0418 \u043A\u043E\u0433\u0434\u0430 \u0443\u0445\u043E\u0434\u0438\u043B\u0438,
      \u0442\u043E \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u0432\u043E\u0434\u044F\u043D\u0443\u044E \u0431\u0430\u0448\u043D\u044E,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0437\u0434\u0435\u0441\u044C \u0441\u0432\u043E\u0438\u0445
      \u043B\u044E\u0434\u0435\u0439. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0443\u0434\u0430
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A \u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438."
    Options:
    - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u044F \u043F\u043E\u0439\u0434\u0443
      \u0438\u0441\u043A\u0430\u0442\u044C \u043F\u0443\u0442\u044C!"
    - "\u041C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u043E\u0447\u044C?"
    NextTalkIndices: ffffffff07000000
  - Text: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0431\u0438\u0442\u044C \u043F\u0443\u0442\u044C \u043F\u043E\u0435\u0437\u0434\u043E\u043C..."
    Options: []
    NextTalkIndices: 
