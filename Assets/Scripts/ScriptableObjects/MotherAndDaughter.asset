  m_Script: {fileID: 11500000, guid: b572d4d6a48a0ad42984e8d22fa97cd4, type: 3}
  m_Name: MotherAndDaughter
  m_EditorClassIdentifier: Assembly-CSharp::Chat
  Name: "\u041C\u0430\u0442\u044C \u0441 \u0440\u0435\u0431\u0451\u043D\u043A\u043E\u043C"
  Talks:
  - Text: "\u041E\u0439, \u0441\u043F\u0430\u0441\u0438\u0431\u043E, \u0448\u0435\u0440\u0438\u0444!
      \u0421\u043F\u0430\u0441\u043B\u0438 \u043D\u0430\u0441 \u0441 \u0434\u043E\u0447\u043A\u043E\u0439
      \u043E\u0442 \u044D\u0442\u0438\u0445\u2026 \u044D\u0442\u0438\u0445 \u043D\u0435\u0433\u043E\u0434\u044F\u0435\u0432!
      \u0410\u0436 \u043A\u043E\u043B\u0435\u043D\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442!"
    Options:
    - "\u041F\u0443\u0441\u0442\u044F\u043A\u0438, \u0434\u0435\u043B\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\u0435.\u041A\u0443\u0434\u0430
      \u044D\u0442\u0438\u2026 \u044D\u044D\u044D\u2026 \u043D\u0435\u0433\u043E\u0434\u044F\u0438
      \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u0438?"
    NextTalkIndices: 01000000
  - Text: "\u041F\u043E \u0440\u0435\u043B\u044C\u0441\u0430\u043C, \u0448\u0435\u0440\u0438\u0444!
      \u041C\u043E\u0441\u0442 \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u0438,
      \u0447\u0442\u043E\u0431 \u0438\u0445 \u0447\u0435\u0440\u0442\u0438 \u0432\u0437\u044F\u043B\u0438!"
    Options:
    - " \u042F\u0441\u043D\u043E. \u0420\u0435\u043B\u044C\u0441\u044B, \u0437\u043D\u0430\u0447\u0438\u0442\u2026 "
    - " \u041A\u0430\u043A \u044D\u0442\u043E\u0442 \u0445\u043B\u0430\u043C \u0441
      \u043F\u0443\u0442\u0435\u0439 \u0443\u0431\u0440\u0430\u0442\u044C-\u0442\u043E? "
    NextTalkIndices: ffffffff02000000
  - Text: "\u0422\u0430\u043A \u043C\u0430\u0448\u0438\u043D\u0438\u0441\u0442 \u0436\u0435!
      \u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u0438\u043C\u2026 \u043A\u0430\u043A
      \u0435\u0433\u043E\u2026 \u043F\u043E\u0435\u0437\u0434\u043E\u043C, \u0442\u0430\u0440\u0430\u043D\u043E\u043C
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C?"
    Options:
    - "\u0422\u0430\u0440\u0430\u043D\u043E\u043C\u2026 \u0425\u043E\u0440\u043E\u0448\u0430\u044F
      \u043C\u044B\u0441\u043B\u044C!"
    - "\u041D\u0443 \u0442\u044B \u0434\u0430\u0435\u0448\u044C, \u043C\u0430\u0442\u044C."
    NextTalkIndices: ffffffffffffffff
