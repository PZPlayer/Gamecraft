  m_Name: Machiniest
  m_EditorClassIdentifier: Assembly-CSharp::Chat
  Name: "\u0414\u044F\u0434\u044F \u0412\u0430\u043D\u044F"
  Talks:
  - Text: "\u0428\u0435\u0440\u0438\u0444! \u0421\u043B\u0430\u0432\u043E \u0431\u043E\u0433\u0443!
      \u0427\u0442\u043E \u0442\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F \u0432
      \u0433\u043E\u0440\u043E\u0434\u0435?"
    Options:
    - "\u041D\u0430 \u043D\u0430\u0441 \u043D\u0430\u043F\u0430\u043B\u0438 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u0438 \u0443\u043A\u0440\u0430\u043B\u0438 \u0434\u0435\u0442\u0435\u0439"
    NextTalkIndices: 01000000
  - Text: "\u041A\u0430\u043A\u043E\u0439 \u0443\u0436\u0430\u0441! \u042F \u043C\u043E\u0433\u0443
      \u0447\u0442\u043E-\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C?"
    Options:
    - "\u041C\u043D\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0432\u0430\u0448 \u043F\u043E\u0435\u0437\u0434"
    - "\u041D\u0435\u0430, \u0434\u0435\u0434\u0443\u043B\u044C"
    NextTalkIndices: 02000000ffffffff
  - Text: "\u0410 \u0437\u0430\u0447\u0435\u043C \u043E\u043D \u0432\u0430\u043C?"
    Options:
    - "\u042F \u0445\u043E\u0447\u0443 \u043F\u0440\u043E\u0442\u0430\u0440\u0430\u043D\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    NextTalkIndices: 03000000
  - Text: "\u0413\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E! \u041A\u043B\u044E\u0447
      \u043D\u0430 \u0431\u043E\u0447\u043A\u0435, \u043F\u043E\u0437\u0430\u0434\u0438
      \u043C\u043E\u0435\u0433\u043E \u0434\u043E\u043C\u0430."
    Options: []
    NextTalkIndices: 
  - Text: "\u041F\u043E\u0435\u0437\u0434 \u0431\u0435\u0437 \u043D\u0435\u0433\u043E
      \u043D\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u0442\u0441\u044F"
    Options:
    - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
    - "\u0410 \u043F\u043E\u0435\u0437\u0434\u0443 \u0445\u0432\u0430\u0442\u0438\u0442
      \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438?"
    NextTalkIndices: ffffffff05000000
  - Text: "\u0421\u043E\u0432\u0441\u0435\u043C \u0437\u0430\u0431\u044B\u043B \u0441\u043A\u0430\u0437\u0430\u0442\u044C!
      \u041D\u0435\u0442, \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u043E\u0442\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0432\u0430\u0433\u043E\u043D\u044B"
    Options: []
    NextTalkIndices: 
